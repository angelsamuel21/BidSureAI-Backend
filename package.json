{
  "name": "gem-compliance-backend",
  "version": "1.0.0",
  "description": "Express Backend for GeM Compliance",
  "main": "server.ts",
  "scripts": {
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register server.ts",
    "build": "tsc --skipLibCheck && tsc-alias",
    "start": "node dist/server.js",
    "seed": "ts-node -r tsconfig-paths/register scripts/seed-db.ts",
    "test": "ts-node -r tsconfig-paths/register scripts/test-engine.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.6",
    "@types/pdf-parse": "^1.1.5",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
